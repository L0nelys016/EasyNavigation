<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EasyNavigation.Controls.AuthControls">

    <Grid RowDefinitions="Auto,*">
        <TabControl Grid.Row="1" Margin="20">

            <TabItem Header="Вход">
                <StackPanel Spacing="10" Margin="10">

                    <TextBox Watermark="Логин"
                             Text="{Binding Login, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White">
                            <Grid Width="230">
                                <TextBox x:Name="PasswordTextBox"
                                         Watermark="Пароль"
                                         Text="{Binding Password, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         PasswordChar="*"
                                         Margin="5,0,35,0"
                                         BorderThickness="0"
                                         Background="Transparent"/>

                                <Button x:Name="ShowPasswordButton"
                                        Width="30"
                                        Height="30"
                                        Click="TogglePasswordVisibility"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,5,0"
                                        IsVisible="False">
                                    <PathIcon Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                </Button>

                                <Button x:Name="HidePasswordButton"
                                        Width="30"
                                        Height="30"
                                        Click="TogglePasswordVisibility"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,5,0"
                                        IsVisible="True">
                                    <PathIcon Data="M20.722,24.964c0.096,0.096,0.057,0.264-0.073,0.306c-7.7,2.466-16.032-1.503-18.594-8.942  c-0.072-0.21-0.072-0.444,0-0.655c0.743-2.157,1.99-4.047,3.588-5.573c0.061-0.058,0.158-0.056,0.217,0.003l4.302,4.302  c0.03,0.03,0.041,0.072,0.031,0.113c-1.116,4.345,2.948,8.395,7.276,7.294c0.049-0.013,0.095-0.004,0.131,0.032  C17.958,22.201,20.045,24.287,20.722,24.964z M24.68,23.266c2.406-1.692,4.281-4.079,5.266-6.941c0.072-0.21,0.072-0.44,0-0.65  C27.954,9.888,22.35,6,16,6c-2.479,0-4.841,0.597-6.921,1.665L3.707,2.293c-0.391-0.391-1.023-0.391-1.414,0s-0.391,1.023,0,1.414  l26,26c0.391,0.391,1.023,0.391,1.414,0c0.391-0.391,0.391-1.023,0-1.414L24.68,23.266z M16,10c3.309,0,6,2.691,6,6  c0,1.294-0.416,2.49-1.115,3.471l-8.356-8.356C13.51,10.416,14.706,10,16,10z"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Content="Войти"
                            Command="{Binding LoginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Width="60"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Регистрация">
                <StackPanel Spacing="10" Margin="10">

                    <TextBox Watermark="Логин"
                             Text="{Binding RegisterLogin, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                    <TextBox Watermark="Email"
                             Text="{Binding RegisterEmail, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>



                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White">
                            <Grid Width="230">
                                <TextBox x:Name="RegPasswordTextBox"
                                         Watermark="Пароль"
                                         Text="{Binding Password, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         PasswordChar="*"
                                         Margin="5,0,35,0"
                                         BorderThickness="0"
                                         Background="Transparent"/>

                                <Button x:Name="RegShowPasswordButton"
                                        Width="30"
                                        Height="30"
                                        Click="RegTogglePasswordVisibility"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,5,0"
                                        IsVisible="False">
                                    <PathIcon Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                </Button>

                                <Button x:Name="RegHidePasswordButton"
                                        Width="30"
                                        Height="30"
                                        Click="RegTogglePasswordVisibility"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,5,0"
                                        IsVisible="True">
                                    <PathIcon Data="M20.722,24.964c0.096,0.096,0.057,0.264-0.073,0.306c-7.7,2.466-16.032-1.503-18.594-8.942  c-0.072-0.21-0.072-0.444,0-0.655c0.743-2.157,1.99-4.047,3.588-5.573c0.061-0.058,0.158-0.056,0.217,0.003l4.302,4.302  c0.03,0.03,0.041,0.072,0.031,0.113c-1.116,4.345,2.948,8.395,7.276,7.294c0.049-0.013,0.095-0.004,0.131,0.032  C17.958,22.201,20.045,24.287,20.722,24.964z M24.68,23.266c2.406-1.692,4.281-4.079,5.266-6.941c0.072-0.21,0.072-0.44,0-0.65  C27.954,9.888,22.35,6,16,6c-2.479,0-4.841,0.597-6.921,1.665L3.707,2.293c-0.391-0.391-1.023-0.391-1.414,0s-0.391,1.023,0,1.414  l26,26c0.391,0.391,1.023,0.391,1.414,0c0.391-0.391,0.391-1.023,0-1.414L24.68,23.266z M16,10c3.309,0,6,2.691,6,6  c0,1.294-0.416,2.49-1.115,3.471l-8.356-8.356C13.51,10.416,14.706,10,16,10z"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                    

                    <TextBox Watermark="Повторите пароль"
                             Text="{Binding RegisterConfirmPassword, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             PasswordChar="*"/>

                    <Button Content="Зарегистрироваться"
                            Command="{Binding RegistrationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Width="170"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
