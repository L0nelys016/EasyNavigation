<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EasyNavigation.Views.Pages.SplashScreenView"
             xmlns:control="using:EasyNavigation.Controls">

	<control:SplashScreenControl
        SplashScreenCommand="{Binding NavigationToAuthCommand}"
        Source="avares://EasyNavigation/Assets/Image/SmartMan.jpg"
		Width="200"
		Height="200"/>
</UserControl>
